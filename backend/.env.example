# LabLens AI - Environment Configuration

# Application
APP_NAME=LabLens AI
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=postgresql://lablens:lablens_password@db:5432/lablens_db

# File Storage (S3-compatible)
STORAGE_ENDPOINT=https://s3.amazonaws.com
STORAGE_BUCKET=lablens-reports
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=true

# AI Provider (OpenAI/Anthropic/Local)
AI_PROVIDER=openai
AI_API_KEY=your-ai-api-key
AI_MODEL=gpt-4o
AI_VISION_MODEL=gpt-4o
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=4096

# OCR Provider (Tesseract/AWS Textract/Azure)
OCR_PROVIDER=tesseract
OCR_API_KEY=
OCR_ENDPOINT=

# Security
MAX_UPLOAD_SIZE=52428800
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png
ENCRYPTION_KEY=your-encryption-key-32chars-long!!

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=INFO
ENABLE_AUDIT_LOG=true

# Retention
REPORT_RETENTION_DAYS=365
AUTO_DELETE_AFTER_DAYS=1095
